    {
      "id": "battery-life",
      "category": "settings",
      "difficulty": 3,
      "prompt": "배터리 오래 가게 해줘. 화면 자동 꺼짐은 30초로, 자동 밝기는 끄고 밝기는 낮게(30% 이하), 배터리 세이버도 켜. 그리고 배터리 제일 많이 쓴 앱이 뭔지도 알려줘.",
      "allow_confirm": true,
      "setup": [
        "dumpsys battery unplug",
        "cmd power set-mode 0",
        "settings put system screen_off_timeout 120000",
        "settings put system screen_brightness_mode 1",
        "settings put system screen_brightness 200"
      ],
      "rubric": [
        {
          "id": "timeout",
          "points": 2,
          "kind": "device",
          "cmd": "settings get system screen_off_timeout",
          "expect": "^30000$"
        },
        {
          "id": "auto-off",
          "points": 1,
          "kind": "device",
          "cmd": "settings get system screen_brightness_mode",
          "expect": "^0$"
        },
        {
          "id": "dim",
          "points": 2,
          "kind": "device",
          "cmd": "settings get system screen_brightness",
          "expect": "^([0-9]|[1-6][0-9]|7[0-6])$"
        },
        {
          "id": "saver",
          "points": 3,
          "kind": "device",
          "cmd": "settings get global low_power",
          "expect": "^1$"
        },
        {
          "id": "top-app",
          "points": 2,
          "kind": "judge",
          "rule": "Names the app(s) with the most battery use as shown in Settings, or says honestly that the phone shows no usage data yet. A made-up list scores 0."
        }
      ],
      "cleanup": [
        "cmd power set-mode 0",
        "dumpsys battery reset",
        "settings put system screen_off_timeout 120000",
        "settings put system screen_brightness_mode 0",
        "settings put system screen_brightness 200"
      ]
    },
    {
      "id": "youtube-notif-off",
      "category": "settings",
