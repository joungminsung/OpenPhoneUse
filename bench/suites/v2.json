    {
      "id": "maps-transit-plan",
      "category": "maps",
      "difficulty": 4,
      "prompt": "지금 서울역에서 강남역까지 대중교통으로 가는 방법을 구글 지도에서 찾아서 정리해줘. 제일 빠른 경로랑 대안 경로들, 각각 걸리는 시간과 환승, 그리고 지금 언제 출발하면 좋은지까지 알려줘.",
      "rubric": [
        {
          "id": "used-maps",
          "points": 1,
          "kind": "trace",
          "pattern": "com\\.google\\.android\\.apps\\.maps|google\\.com/maps|maps\\.google"
        },
        {
          "id": "main-route",
          "points": 2,
          "kind": "judge",
          "rule": "Gives the fastest route with total time and the line names (e.g. Line 4 → Line 2 or a bus number) as Maps showed them."
        },
        {
          "id": "alternatives",
          "points": 3,
          "kind": "judge",
          "rule": "Gives at least two alternative routes, each with its time (1.5 per alternative)."
        },
        {
          "id": "transfers",
          "points": 1,
          "kind": "judge",
          "rule": "Says the transfers/walking for the routes."
        },
        {
          "id": "timing",
          "points": 2,
          "kind": "judge",
          "rule": "Advises when to leave or what to do if the next departure is missed (e.g. 'the next bus is in 4 min; if you miss it take B')."
        },
        {
          "id": "grounded",
          "points": 1,
