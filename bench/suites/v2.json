    {
      "id": "device-info",
      "category": "settings",
      "difficulty": 2,
      "prompt": "이 폰 안드로이드 버전이랑 보안 패치 날짜, 남은 저장 공간 알려줘.",
      "facts": [
        "getprop ro.build.version.release",
        "getprop ro.build.version.security_patch",
        "df -h /data | tail -1"
      ],
      "rubric": [
        {
          "id": "version",
          "points": 2,
          "kind": "reply",
          "pattern": "(?i)(android|안드로이드)\\D{0,6}16"
        },
        {
          "id": "patch",
          "points": 2,
          "kind": "judge",
          "rule": "Gives the security patch date that matches the facts (any date format)."
        },
        {
          "id": "storage",
          "points": 2,
          "kind": "judge",
          "rule": "Gives free storage within about 20% of the 'df' fact (Settings may round or count differently; accept Settings' own number if plausible)."
        }
      ]
    },
