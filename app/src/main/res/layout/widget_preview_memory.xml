<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview of memory (static; the widget itself is drawn by Glance): the label with the round
     ink add button, the two newest memories and the count. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_memory_preview_title"
            android:textColor="@color/widget_preview_sub"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_preview_round_ink"
            android:contentDescription="@string/widget_memory_preview"
            android:padding="13dp"
            android:src="@drawable/ic_widget_add"
            android:tint="@color/widget_preview_on_ink" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:text="@string/widget_memory_preview_1"
        android:textColor="@color/widget_preview_text"
        android:textSize="14.5sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:maxLines="1"
        android:text="@string/widget_memory_preview_2"
        android:textColor="@color/widget_preview_text"
        android:textSize="14.5sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_memory_preview_count"
        android:textColor="@color/widget_preview_sub"
        android:textSize="12.5sp" />
</LinearLayout>
