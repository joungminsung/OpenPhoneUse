<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview of the memory widget (static; the widget itself is drawn by Glance). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/widget_preview_dot"
        android:importantForAccessibility="no"
        android:padding="6dp"
        android:src="@drawable/ic_widget_bulb"
        android:tint="@color/widget_preview_accent" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:maxLines="3"
        android:text="@string/widget_memory_preview"
        android:textColor="@color/widget_preview_text"
        android:textSize="14sp" />
</LinearLayout>
